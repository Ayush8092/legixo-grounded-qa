# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Groq
GROQ_API_KEY=your_groq_api_key_here

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone configuration
PINECONE_INDEX_NAME=legixo-grounded-qa
PINECONE_NAMESPACE=legixo-corpus
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_READY_TIMEOUT_SECONDS=120
# Embeddings
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

# LLM
ANSWER_MODEL=llama-3.1-8b-instant

# Retrieval
TOP_K=10
SCORE_THRESHOLD=0.45

# Reranking (lightweight lexical BM25, no extra model/API — see app/reranker.py)
RERANK_ENABLED=true
RERANK_TOP_K=8

# LangGraph
MAX_RETRIEVAL_LOOPS=2
QUERY_FANOUT=3
RECURSION_LIMIT=20

# API
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# Upload
CORPUS_DIR=data/corpus
UPLOAD_DIR=data/uploads
MAX_UPLOAD_FILE_SIZE_BYTES=10485760

# Trace
INCLUDE_TRACE=false